{
  "name": "blackbox-web-reverse",
  "version": "1.0.1",
  "description": "Authorized black-box web application reverse-engineering workflow for AI agents",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYTPONS/blackbox-web-reverse.git"
  },
  "homepage": "https://github.com/MYTPONS/blackbox-web-reverse#readme",
  "bugs": {
